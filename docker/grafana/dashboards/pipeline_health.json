{
  "uid": "jm-pipeline-health",
  "title": "Job Market Pipeline - run log",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "timezone": "browser",
  "tags": [
    "pipeline"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Scheduled pipeline runs recorded in ops.pipeline_runs (launchd runs, from Oct 27, 2026).",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs logged",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS runs FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Scheduled launchd runs recorded in ops.pipeline_runs within the selected time range."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status = 'success') / NULLIF(count(*), 0) AS success_rate FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Share of logged runs with status 'success'. Logging started on Oct 27, 2026, so earlier runs are not counted here."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FILTER (WHERE status <> 'success') AS failed FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total postings (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT jobs_total FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND jobs_total IS NOT NULL ORDER BY run_ts DESC LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "API call success rate",
      "description": "Share of HTTP attempts that succeeded, over runs that logged API counters (started with the API-logging change; earlier runs have none).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * (SUM(api_calls) - SUM(api_retries) - SUM(api_failures)) / NULLIF(SUM(api_calls), 0) AS rate FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND api_calls IS NOT NULL AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "API retries",
      "description": "Attempts that failed and were retried (up to 3 attempts per page), summed over the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(SUM(api_retries), 0) AS retries FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND api_calls IS NOT NULL AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pages skipped after all attempts failed",
      "description": "Pages that failed every attempt and were skipped, summed over the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(SUM(api_failures), 0) AS failed_pages FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND api_calls IS NOT NULL AND $__timeFilter(run_ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "New postings per run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_ts AS \"time\", jobs_added AS \"new postings\" FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND jobs_added IS NOT NULL AND $__timeFilter(run_ts) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Net new unique postings added by each scheduled run (change in total postings since the previous logged run)."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Total postings",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_ts AS \"time\", jobs_total AS \"total postings\" FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' AND jobs_total IS NOT NULL AND $__timeFilter(run_ts) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jm-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jm-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_ts AS \"time\", run_id, status, failed_task, raw_records, api_calls, api_retries, api_failures, jobs_added, jobs_total FROM ops.pipeline_runs WHERE run_id LIKE 'launchd%' ORDER BY run_ts DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0,
                        "text": "success"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}